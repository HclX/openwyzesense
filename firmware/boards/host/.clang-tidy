# Test and host-simulation code: reads test vectors and command lines with sscanf / atoi, copies binary payloads with
# memcpy, and its struct layout does not matter. The firmware's own rules (../.clang-tidy) apply otherwise.
InheritParentConfig: true
Checks: >
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-not-null-terminated-result,
  -bugprone-implicit-widening-of-multiplication-result,
  -clang-analyzer-optin.performance.Padding
